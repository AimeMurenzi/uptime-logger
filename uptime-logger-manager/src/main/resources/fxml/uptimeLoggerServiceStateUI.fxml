<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<!-- <?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?> -->

<GridPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
   prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22"
   xmlns:fx="http://javafx.com/fxml/1">
   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
   </rowConstraints>
   <children>
      <Button fx:id="installBTN" alignment="CENTER" maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Install"
         GridPane.columnIndex="2">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Button>
      <Button fx:id="enableBTN" alignment="CENTER" layoutX="10.0" layoutY="110.0"
         maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
         mnemonicParsing="false" text="Enable" GridPane.columnIndex="2" GridPane.rowIndex="1">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Button>
      <Label fx:id="installedStateLabel" alignment="CENTER" layoutX="10.0" layoutY="10.0"
         maxWidth="1.7976931348623157E308" text="✖" GridPane.columnIndex="1">
         <font>
            <Font name="System Bold" size="64.0" />
         </font>
      </Label>
      <Label fx:id="enabledStateLabel" alignment="CENTER" layoutX="10.0" layoutY="10.0"
         maxWidth="1.7976931348623157E308" text="✖" GridPane.columnIndex="1" GridPane.rowIndex="1">
         <font>
            <Font name="System Bold" size="64.0" />
         </font>
      </Label>
      <Label fx:id="runningStateLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="10.0"
         layoutY="10.0" maxWidth="1.7976931348623157E308" text="✔" textAlignment="CENTER"
         GridPane.columnIndex="1" GridPane.rowIndex="2">
         <font>
            <Font name="System Bold" size="64.0" />
         </font>
      </Label>
      <Label layoutX="10.0" layoutY="362.0" text="Running" GridPane.rowIndex="2">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      <Label layoutX="10.0" layoutY="270.0" text="Enabled" GridPane.rowIndex="1">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      <Label layoutX="10.0" layoutY="190.0" text="Installed">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      <Button fx:id="startBTN" alignment="CENTER" layoutX="410.0" layoutY="170.0"
         maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
         mnemonicParsing="false" text="Start" GridPane.columnIndex="2" GridPane.rowIndex="2">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Button>
      <!-- <FontAwesomeIconView fx:id="statusIcon" iconName="CHECK" size="48" layoutX="50"
      layoutY="50" GridPane.rowIndex="5" /> -->
   </children>
</GridPane>