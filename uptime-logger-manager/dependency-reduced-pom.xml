<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>${app.parent.artifactId}</artifactId>
    <groupId>${app.parent.groupId}</groupId>
    <version>${app.parent.version}</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>${app.artifactId}</artifactId>
  <packaging>${app.child.packaging}</packaging>
  <name>${app.name}</name>
  <description>${app.description}</description>
  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
        <version>1.2.1</version>
        <executions>
          <execution>
            <phase>generate-resources</phase>
            <goals>
              <goal>write-project-properties</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.outputDirectory}/app.properties</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.1.2</version>
        <executions>
          <execution>
            <id>copy-uptime-loger-service-jar</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>${app.parent.groupId}</groupId>
                  <artifactId>${app.uptimeServiceName}</artifactId>
                  <version>${app.parent.version}</version>
                  <outputDirectory>${basedir}/src/main/resources/services</outputDirectory>
                  <destFileName>${app.uptimeServiceName}.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>2.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>be.freeaime.app.base.${app.entryPoint}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <app.description>Installs and manages the state of uptime logger service.</app.description>
    <app.entryPoint>EntryPointULM</app.entryPoint>
    <app.artifactId>uptime-logger-manager</app.artifactId>
    <app.name>uptime logger manager</app.name>
  </properties>
</project>

